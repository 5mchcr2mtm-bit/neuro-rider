
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Entraînement - Neuro'Rider</title>
<link rel="stylesheet" href="../css/style.css">
<style>
.quiz-question { font-size:20px; font-weight:bold; }
.answer {
  display:block; width:100%; padding:16px;
  margin:10px 0; border:2px solid #2375a8;
  border-radius:12px; background:white;
  color:#14283f; text-align:left; font-size:16px;
}
.answer:disabled { opacity:0.8; }
#feedback { font-weight:bold; margin:20px 0; }
#next { display:none; }
</style>
</head>
<body>

<header class="header">
<a class="logo" href="../index.html">🏍️ Neuro’Rider</a>
<nav>
<a href="../index.html">Accueil</a>
<a href="espace.html">Mon espace</a>
<a href="cours.html">Cours</a>
</nav>
</header>

<main class="page">
<p class="eyebrow">ENTRAÎNEMENT ETM A2</p>
<h1>À toi de jouer ! 🎯</h1>
<p>Une question à la fois. Prends ton temps.</p>

<section class="panel">
<p id="progress">Question 1 / 5</p>
<p id="question" class="quiz-question"></p>
<div id="answers"></div>
<p id="feedback" aria-live="polite"></p>
<button id="next" class="button" onclick="nextQuestion()">Question suivante</button>
<p id="score"></p>
</section>

<a class="small-link" href="espace.html">← Retour à mon espace</a>
</main>

<footer>Neuro’Rider · Chaque question te fait progresser.</footer>

<script>
const questions = [
{
q:"Que signifie généralement un panneau triangulaire à bord rouge ?",
a:["Une obligation","Un danger","Une interdiction"],
correct:1,
explain:"Le triangle à bord rouge annonce généralement un danger."
},
{
q:"Quelle distance de sécurité minimale recommande la règle générale du code ?",
a:["Une seconde","Deux secondes","Dix secondes"],
correct:1,
explain:"La règle générale est de conserver au moins deux secondes."
},
{
q:"Quel équipement est obligatoire à moto ?",
a:["Un casque homologué attaché et des gants certifiés","Un blouson en cuir","Des bottes de compétition"],
correct:0,
explain:"Le casque homologué attaché et les gants certifiés sont obligatoires."
},
{
q:"Pourquoi vérifier la pression des pneus ?",
a:["Pour améliorer la tenue de route","Pour augmenter la puissance","Pour économiser le nettoyage"],
correct:0,
explain:"Une pression adaptée contribue à la stabilité et à l'adhérence."
},
{
q:"Que faut-il faire avant de changer de voie ?",
a:["Accélérer sans regarder","Contrôler autour de soi et signaler son intention","Regarder uniquement devant"],
correct:1,
explain:"Il faut observer, contrôler les angles morts et signaler son intention."
}
];

let current = 0;
let points = 0;
let answered = false;

function showQuestion() {
answered = false;
const item = questions[current];
document.getElementById("progress").textContent =
"Question " + (current+1) + " / " + questions.length;
document.getElementById("question").textContent = item.q;
document.getElementById("feedback").textContent = "";
document.getElementById("score").textContent = "";
document.getElementById("next").style.display = "none";

const area = document.getElementById("answers");
area.innerHTML = "";

item.a.forEach((answer,index) => {
const button = document.createElement("button");
button.className = "answer";
button.textContent = String.fromCharCode(65+index) + " — " + answer;
button.onclick = () => checkAnswer(index);
area.appendChild(button);
});
}

function checkAnswer(index) {
if(answered) return;
answered = true;

const item = questions[current];
const buttons = document.querySelectorAll(".answer");

buttons.forEach(button => button.disabled = true);

if(index === item.correct) {
points++;
document.getElementById("feedback").textContent =
"✅ Bonne réponse ! " + item.explain;
} else {
document.getElementById("feedback").textContent =
"💡 Pas tout à fait. " + item.explain;
}

document.getElementById("next").style.display = "inline-block";
document.getElementById("next").textContent =
current === questions.length-1 ? "Voir mon résultat" : "Continuer";
}

function nextQuestion() {
if(!answered) return;
current++;

if(current < questions.length) {
showQuestion();
} else {
document.getElementById("progress").textContent = "Entraînement terminé !";
document.getElementById("question").textContent = "Bravo pour tes efforts ! 🏍️";
document.getElementById("answers").innerHTML = "";
document.getElementById("feedback").textContent =
"Ton résultat : " + points + " / " + questions.length;
document.getElementById("next").style.display = "none";
document.getElementById("score").textContent =
points === 5 ? "Excellent ! Toutes les réponses sont justes." :
"Continue à t'entraîner, tu progresses à chaque essai !";
}
}

showQuestion();
</script>
</body>
</html>
